# ========================================================
# CONFIGURACIÓN DEL ARNES DE AGENTES (SOFTWARE FACTORY)
# ========================================================

# Proveedor por defecto: openai, anthropic, gemini, deepseek, ollama
AI_PROVIDER=gemini

# Modelo específico según el proveedor:
# Para Gemini: gemini-2.5-flash o gemini-2.5-pro
# Para DeepSeek: deepseek/deepseek-chat
# Para Claude: claude-3-7-sonnet-20250219
# Para Ollama: qwen2.5-coder:14b o llama3.3
AI_MODEL=gemini-2.5-flash

# API Keys (Llena la que corresponda al proveedor que vayas a usar):
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Ollama (Si corres IA local sin costo):
OLLAMA_BASE_URL=http://localhost:11434

# Configuración del Harness:
MAX_CORRECTION_ITERATIONS=5
AUTO_APPROVE=false
