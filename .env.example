# =====================================================================
# SRP-BIESS · Variables de Entorno de Ejemplo (.env.example)
# Copiar este archivo a .env y ajustar según corresponda:
#   Windows: copy .env.example .env
#   Linux/macOS: cp .env.example .env
# =====================================================================

# ---------------------------------------------------------------------
# Entorno General y Servidor HTTP (Go Fiber)
# ---------------------------------------------------------------------
APP_NAME=srp-biess-api
APP_ENV=development
APP_PORT=8080
APP_DEBUG=true
# Lista separada por comas. En development, vacío permite localhost; en
# production, vacío rechaza todos los orígenes.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------
# Persistencia Relacional (PostgreSQL 16)
# ---------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=srp_user
DB_PASSWORD=srp_secret_password
DB_NAME=srp_biess
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m
DATABASE_URL=postgres://srp_user:srp_secret_password@localhost:5432/srp_biess?sslmode=disable

# ---------------------------------------------------------------------
# Caché y Control de Intentos (Redis 7)
# ---------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CATALOG_TTL=86400
REDIS_AUTH_LOCK_TTL=600
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------
# Seguridad y Tokens JWT
# ---------------------------------------------------------------------
JWT_SECRET=super_secret_biess_jwt_key_development_2026_xyz
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=8

# ---------------------------------------------------------------------
# Servidor de Correo / Notificaciones (Mailpit en local)
# ---------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=notificaciones-concurso@biess.gob.ec
SMTP_FROM_NAME="Concurso Directorio BIESS"

# ---------------------------------------------------------------------
# Almacenamiento de Documentos PDF
# ---------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
UPLOAD_MAX_FILE_BYTES=4194304
UPLOAD_MAX_TOTAL_BYTES=52428800

# ---------------------------------------------------------------------
# Proveedores e Integraciones (ADR-010, ADR-013)
# Opciones disponibles: mock | production
# ---------------------------------------------------------------------
IDENTITY_PROVIDER=mock
EMPLOYMENT_PROVIDER=mock
# Espera máxima del Historial Laboral IESS; al superarla, PUT /cargo responde 503 (SRP-017a)
IESS_TIMEOUT=5s

